# GEMINI_API_KEY: Required if Gemini AI API features are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Supabase Configuration (Optional - server runs local persistent transactional store when unset)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay Server-Side Payment Integration (Optional - runs Sandbox Demo Mode when unset)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional Admin Passcode for Administrator Dashboard Login
ADMIN_PASSCODE=
